---
import { large } from '../lib/images';
import { url } from '../lib/url';

interface Props {
  path: string;
  title: string;
  class?: string;
}

const { path, title, class: className } = Astro.props;
const isPdf = path.toLowerCase().endsWith('.pdf');
const image = isPdf ? null : await large(path, 2000);
const href = isPdf ? url(path) : image!.original;
---

{
  isPdf ? (
    <a href={href} class={className} data-pdf={href} data-pdf-title={title} target="_blank" rel="noopener">
      <slot />
    </a>
  ) : (
    <a
      href={href}
      class={className}
      data-doc={image!.src}
      data-doc-w={image!.width}
      data-doc-h={image!.height}
      data-doc-title={title}
      target="_blank"
      rel="noopener"
    >
      <slot />
    </a>
  )
}
