---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
---

<section class="vblock" aria-labelledby="vblock-title">
  <div class="container">
    <button type="button" class="vblock__frame" data-video-open aria-label="Дивитись відео: кар’єр з висоти, 2:10">
      <span class="vblock__media media" data-vblock-media>
        <Picture src="/assets/images/quarry/video-poster.jpg" alt="Кар’єр у Любимівці з висоти" widths={[640, 960, 1280]} sizes="100vw" />
      </span>
      <span class="vblock__shade"></span>
      <span class="vblock__content">
        <span class="eyebrow">Відео · 2:10</span>
        <span class="vblock__title h2" id="vblock-title">Кар’єр з висоти</span>
      </span>
      <span class="vblock__play" data-magnetic><Icon name="play" /></span>
    </button>
  </div>
</section>

<style>
  .vblock {
    padding-block: clamp(40px, 6vw, 80px);
  }

  .vblock__frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: clamp(16px, 2vw, 28px);
    overflow: hidden;
    text-align: left;
    color: var(--text);
  }

  @media (min-width: 960px) {
    .vblock__frame {
      aspect-ratio: 21 / 9;
    }
  }

  .vblock__media {
    position: absolute;
    inset: 0;
  }

  .vblock__media :global(img) {
    transform: scale(1.15);
  }

  .vblock__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(13, 13, 12, 0.85), rgba(13, 13, 12, 0.1) 60%);
  }

  .vblock__content {
    position: absolute;
    left: clamp(20px, 4vw, 56px);
    bottom: clamp(20px, 4vw, 56px);
    display: grid;
    gap: 14px;
  }

  .vblock__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: clamp(76px, 9vw, 128px);
    aspect-ratio: 1;
    margin: calc(clamp(76px, 9vw, 128px) / -2) 0 0 calc(clamp(76px, 9vw, 128px) / -2);
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    transition: transform 0.6s var(--ease);
  }

  .vblock__play::before {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1px solid rgba(251, 128, 7, 0.5);
    animation: pulse 2.4s var(--ease) infinite;
  }

  .vblock__play :global(.icon) {
    width: 34%;
    height: 34%;
    margin-left: 6%;
  }

  .vblock__frame:hover .vblock__play {
    transform: scale(1.08);
  }

  @keyframes pulse {
    from {
      transform: scale(0.85);
      opacity: 1;
    }
    to {
      transform: scale(1.35);
      opacity: 0;
    }
  }
</style>
