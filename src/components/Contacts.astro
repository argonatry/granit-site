---
import Icon from './Icon.astro';
import Button from './Button.astro';
import MapBlock from './MapBlock.astro';
import { site } from '../lib/data';

interface Props {
  map?: boolean;
  title?: string;
  headingLevel?: 'h1' | 'h2';
}

const { map = false, title = 'Контакти', headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="contacts section" id="contacts" aria-labelledby="contacts-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow">Зв’язок</p>
        <Heading class="h2 contacts__title" id="contacts-title" data-split>{title}</Heading>
      </div>
      <p class="lead">Телефонуйте, пишіть або залиште заявку — підберемо фракцію під ваш об’єкт і порахуємо вартість.</p>
    </div>

    <div class="contacts__grid">
      <div class="contacts__info">
        <div class="contacts__card contacts__card--wide" data-reveal>
          <p class="field__label"><Icon name="phone" /> Телефон</p>
          {site.phones.map((p) => <a class="contacts__big link-line" href={`tel:${p.tel}`}>{p.label}</a>)}
        </div>

        <div class="contacts__card" data-reveal>
          <p class="field__label"><Icon name="mail" /> Email</p>
          <a class="link-line" href={`mailto:${site.email}`}>{site.email}</a>
        </div>

        <div class="contacts__card" data-reveal>
          <p class="field__label"><Icon name="clock" /> Режим роботи</p>
          <p>{site.hours.weekdays}<br /><span class="muted">{site.hours.weekend}</span></p>
        </div>

        <div class="contacts__card" data-reveal>
          <p class="field__label"><Icon name="card" /> {site.representative.title}</p>
          <p>Представник: {site.representative.name}</p>
          <a class="link-line" href={`tel:${site.representative.phone.tel}`}>{site.representative.phone.label}</a>
        </div>

        <div class="contacts__card" data-reveal>
          <p class="field__label"><Icon name="viber" /> Месенджери</p>
          <div class="contacts__msg">
            <a href={site.messengers.viber} class="chip"><Icon name="viber" />Viber</a>
            <a href={site.messengers.telegram} class="chip" target="_blank" rel="noopener"><Icon name="telegram" />Telegram</a>
          </div>
        </div>

        {
          site.addresses.map((a) => (
            <div class="contacts__card" data-reveal>
              <p class="field__label">
                <Icon name="pin" /> {a.title}
              </p>
              <p>{a.text}</p>
            </div>
          ))
        }
      </div>

      <form class="contacts__form" data-form="feedback" novalidate data-reveal>
        <p class="h3">Зворотний зв’язок</p>
        <input type="hidden" name="type" value="feedback" />
        <input type="hidden" name="startedAt" value="" />
        <label class="hp" aria-hidden="true">Сайт <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        <div class="field">
          <label class="field__label" for="fb-name">Ваше ім'я <b>*</b></label>
          <input class="input" id="fb-name" name="name" type="text" autocomplete="name" required maxlength="80" placeholder="Як до вас звертатися?" />
          <p class="field__error" data-error="name"></p>
        </div>
        <div class="field">
          <label class="field__label" for="fb-phone">Номер телефону <b>*</b></label>
          <input class="input" id="fb-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required placeholder="+38 (0__) ___-__-__" data-phone />
          <p class="field__error" data-error="phone"></p>
        </div>
        <div class="field">
          <label class="field__label" for="fb-message">Повідомлення або запитання</label>
          <textarea class="input" id="fb-message" name="message" rows="4" maxlength="1000" placeholder="Опишіть, що саме вас цікавить"></textarea>
        </div>
        {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="dark" data-size="flexible" data-appearance="interaction-only" />}
        <Button type="submit" block data-submit>Відправити запит</Button>
        <p class="form-status" data-form-status role="status"></p>
      </form>
    </div>

    {map && <MapBlock />}
  </div>
</section>

<style>
  .contacts__grid {
    display: grid;
    gap: 16px;
    align-items: start;
  }

  .contacts__info {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .contacts__card {
    display: grid;
    gap: 10px;
    align-content: start;
    justify-items: start;
    padding: 24px;
    background: var(--bg);
  }

  .contacts__card .field__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .contacts__card .field__label :global(.icon) {
    width: 16px;
    height: 16px;
    color: var(--accent);
  }

  .contacts__big {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .contacts__msg {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .contacts__msg .chip :global(.icon) {
    width: 18px;
    height: 18px;
  }

  .contacts__form {
    display: grid;
    gap: 16px;
    padding: clamp(22px, 3.4vw, 40px);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-2);
    background-image: var(--granite);
  }

  @media (min-width: 720px) {
    .contacts__info {
      grid-template-columns: 1fr 1fr;
    }

    .contacts__card--wide,
    .contacts__card:last-child:nth-child(even) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .contacts__grid {
      grid-template-columns: 1.5fr 1fr;
    }

    .contacts__form {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
</style>
