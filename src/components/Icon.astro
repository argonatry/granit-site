  list: '<path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  viber: '<path d="M12 3c-4.4 0-8 2.7-8 7.5 0 2.6 1 4.5 2.6 5.7V20l3-2c.8.2 1.6.3 2.4.3 4.4 0 8-2.7 8-7.8S16.4 3 12 3z"/><path d="M9.6 8.4c.3-.3.8-.3 1 0l.8 1c.2.3.2.7-.1 1l-.4.4c.4.9 1.1 1.6 2 2l.4-.4c.3-.3.7-.3 1-.1l1 .8c.3.2.3.7 0 1-.6.7-1.6.9-2.4.5a7.4 7.4 0 0 1-3.7-3.7c-.4-.8-.2-1.8.4-2.5z"/>',
