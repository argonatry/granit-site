---
import { site } from '../lib/data';
---

<div class="stats" data-reveal-group>
  {
    site.stats.map((s) => (
      <div class="stats__item" data-reveal>
        <p class="stats__value">
          {s.prefix && <span class="stats__affix">{s.prefix}</span>}
          <span data-count={s.value}>{s.value}</span>
          {s.suffix && <span class="stats__affix">{s.suffix}</span>}
        </p>
        <p class="stats__label muted">{s.label}</p>
      </div>
    ))
  }
</div>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
  }

  .stats__item {
    display: grid;
    gap: 10px;
    padding: clamp(24px, 3vw, 40px) clamp(12px, 2vw, 32px) clamp(24px, 3vw, 40px) 0;
    border-bottom: 1px solid var(--line);
  }

  .stats__item:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  .stats__item:nth-child(even) {
    padding-left: clamp(12px, 2vw, 32px);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 5.4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .stats__affix {
    color: var(--accent);
    font-size: 0.6em;
    letter-spacing: -0.02em;
  }

  .stats__label {
    font-size: 0.92rem;
  }

  @media (min-width: 1024px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }

    .stats__item,
    .stats__item:nth-child(even) {
      padding-left: clamp(16px, 2vw, 32px);
      border-right: 1px solid var(--line);
    }

    .stats__item:first-child {
      padding-left: 0;
    }

    .stats__item:last-child {
      border-right: 0;
    }
  }
</style>
