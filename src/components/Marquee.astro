---
const words = ['Щебінь', 'Відсів', 'Бут', 'ЩПС', 'Суглинок', 'ДСТУ', '1 клас радіоактивності', 'Доставка авто та залізницею'];
---

<div class="marquee" aria-hidden="true" data-marquee>
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="marquee__group">
          {words.map((w) => (
            <span class="marquee__item">
              {w}
              <i />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding: clamp(18px, 2.4vw, 30px) 0;
    border-block: 1px solid var(--line);
    background: var(--bg);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group {
    display: flex;
    flex: none;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 3vw, 44px);
    padding-right: clamp(20px, 3vw, 44px);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .marquee__item:nth-child(even) {
    color: transparent;
    -webkit-text-stroke: 1px var(--text-2);
  }

  .marquee__item i {
    width: 0.32em;
    height: 0.32em;
    background: var(--accent);
    rotate: 45deg;
  }

  :global(.reduced) .marquee__track {
    animation: none;
  }
</style>
