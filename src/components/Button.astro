---
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  href?: string;
  variant?: 'accent' | 'ghost' | 'dark';
  size?: 'md' | 'sm';
  icon?: Parameters<typeof Icon>[0]['name'] | false;
  block?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'accent', size = 'md', icon = 'arrow', block = false, class: extra = '', ...rest } = Astro.props;
const classes = [
  'btn',
  variant !== 'accent' && `btn--${variant}`,
  size === 'sm' && 'btn--sm',
  block && 'btn--block',
  extra,
]
  .filter(Boolean)
  .join(' ');
const Tag = href ? 'a' : 'button';
const label = await Astro.slots.render('default');
---

<Tag class={classes} href={href && url(href)} type={href ? undefined : 'button'} data-magnetic {...rest}>
  <span class="btn__label"><span set:html={label} /><span aria-hidden="true" set:html={label} /></span>
  {icon && <Icon name={icon} />}
</Tag>
